    "models = {\n",
    "    \"Linear Regression\": LinearRegression(),\n",
    "    \"Random Forest\": RandomForestRegressor(n_estimators=200, random_state=0, n_jobs=-1),\n",
    "    \"Gradient Boosting\": GradientBoostingRegressor(n_estimators=200, random_state=0),\n",
    "}\n",
    " \n",
    "kf = KFold(n_splits=5, shuffle=True, random_state=0)\n",
    "rows = []\n",
    "for name, m in models.items():\n",
    "    m.fit(X_train, y_train)\n",
    "    pred_sqrt = m.predict(X_test)\n",
    " \n",
    "    # back-transform: square to get real bike counts\n",
    "    actual = y_test ** 2\n",
    "    pred = np.clip(pred_sqrt, 0, None) ** 2\n",
    " \n",
    "    cv = cross_val_score(m, X, y, cv=kf, scoring=\"r2\")\n",
    "    rows.append({\n",
    "        \"Model\": name,\n",
    "        \"Train R2\": round(r2_score(y_train, m.predict(X_train)), 3),\n",
    "        \"Test R2\": round(r2_score(actual, pred), 3),\n",
    "        \"Test RMSE\": round(np.sqrt(mean_squared_error(actual, pred)), 1),\n",
    "        \"Test MAE\": round(mean_absolute_error(actual, pred), 1),\n",
    "        \"5-fold CV R2\": round(cv.mean(), 3),\n",
    "    })\n",
    " \n",
    "results = pd.DataFrame(rows)\n",
    "print(results.to_string(index=False))"
   ]
